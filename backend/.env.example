# Copy to backend/.env and fill in. Never commit the real file.

# --- Supabase ----------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key. Server-side only, bypasses RLS -- used exclusively by the
# background pipeline worker, never on a request path. See docs/security.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to verify the JWTs the frontend sends (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=your-jwt-secret

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- vector store ------------------------------------------------------------
CHROMA_PERSIST_DIR=./.chroma
# Where sentence-transformers caches its model (~90MB, downloaded once).
EMBEDDING_CACHE_DIR=./.models

# --- scrapers ----------------------------------------------------------------
# Used by app/scrapers/. These are the migrated Daraz scraper's own defaults.
SCRAPER_TIMEOUT=25
# Browser navigation budget. Must be larger than SCRAPER_TIMEOUT -- Daraz
# product pages routinely need 30-45s to render.
PLAYWRIGHT_TIMEOUT=60
# Abort image/font/media requests in the headless browser (much faster).
PLAYWRIGHT_BLOCK_MEDIA=true
# Render one page at a time; two Chromium instances starve each other.
PLAYWRIGHT_SERIALIZE=true
SCRAPER_ENABLE_PLAYWRIGHT=true
SCRAPER_MAX_REVIEWS=40
# Alibaba: minimum seconds between requests (raised if robots.txt asks for
# more), and how many wordings of a product title to search before giving up.
ALIBABA_REQUEST_DELAY_SECONDS=2.5
ALIBABA_MAX_SEARCH_QUERIES=3
# Website: how far a crawl goes from the submitted link, and how politely.
WEBSITE_MAX_PAGES=12
WEBSITE_MAX_DEPTH=2
WEBSITE_REQUEST_DELAY_SECONDS=1.5
WEBSITE_RESPECT_ROBOTS_TXT=true
# A page with less text than this is treated as a JavaScript shell and
# re-rendered in the headless browser.
WEBSITE_MIN_HTTP_TEXT_LENGTH=500
# Instagram scraping runs on Apify's hosted Instagram actor: Apify does the
# fetching and returns JSON, so this project never touches Instagram directly.
# Token from apify.com -> Settings -> API & Integrations. Without it the
# Instagram platform reports itself unavailable instead of failing mid-run.
APIFY_API_TOKEN=your-apify-token
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# Posts read per profile, and comments read per post. Every collected post can
# be opened on the results screen and shows its comments there, so the post
# budget is what bounds the scrape.
INSTAGRAM_POSTS_LIMIT=12
INSTAGRAM_COMMENTS_LIMIT=20
# Comments are a second, slow actor run. 0 reads every collected post's
# comments; a positive value caps it at that many posts, busiest first. Every
# post keeps its like and comment counts regardless.
INSTAGRAM_COMMENT_POSTS_LIMIT=0

# --- app ---------------------------------------------------------------------
# When true (or when Supabase is unconfigured) the API serves the seeded demo
# dataset from app/services/demo_data.py instead of touching a database.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
