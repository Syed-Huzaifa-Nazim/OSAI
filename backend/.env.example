# Copy to backend/.env and fill in. Never commit the real file.

# --- Supabase ----------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key. Server-side only, bypasses RLS -- used exclusively by the
# background pipeline worker, never on a request path. See docs/security.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to verify the JWTs the frontend sends (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=your-jwt-secret

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- vector store ------------------------------------------------------------
CHROMA_PERSIST_DIR=./.chroma
# Where sentence-transformers caches its model (~90MB, downloaded once).
EMBEDDING_CACHE_DIR=./.models

# --- scrapers ----------------------------------------------------------------
# Used by app/scrapers/. These are the migrated Daraz scraper's own defaults.
SCRAPER_TIMEOUT=25
# Browser navigation budget. Must be larger than SCRAPER_TIMEOUT -- Daraz
# product pages routinely need 30-45s to render.
PLAYWRIGHT_TIMEOUT=60
# Abort image/font/media requests in the headless browser (much faster).
PLAYWRIGHT_BLOCK_MEDIA=true
# Render one page at a time; two Chromium instances starve each other.
PLAYWRIGHT_SERIALIZE=true
SCRAPER_ENABLE_PLAYWRIGHT=true
SCRAPER_MAX_REVIEWS=40
# Alibaba: minimum seconds between requests (raised if robots.txt asks for
# more), and how many wordings of a product title to search before giving up.
ALIBABA_REQUEST_DELAY_SECONDS=2.5
ALIBABA_MAX_SEARCH_QUERIES=3

# --- app ---------------------------------------------------------------------
# When true (or when Supabase is unconfigured) the API serves the seeded demo
# dataset from app/services/demo_data.py instead of touching a database.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
