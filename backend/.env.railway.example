# Railway service: OSAI, root directory /backend. Set values as Railway service variables.
# Leave demo mode on until real Supabase and LLM credentials are configured.
ENVIRONMENT=production
DEMO_MODE=true
CORS_ORIGINS=https://optistratixai.vercel.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APIFY_API_TOKEN=
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_CACHE_DIR=./.models
