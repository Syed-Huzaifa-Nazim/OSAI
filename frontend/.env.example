# Copy to frontend/.env.local and fill in. Never commit the real file.
#
# With every value left blank the app runs in demo mode against the seeded
# sample project, so a fresh clone is fully walkable with no setup.

# Where the FastAPI backend lives. In development, Vite proxies /api to
# VITE_API_PROXY_TARGET, so the default below usually needs no change.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Supabase ----------------------------------------------------------------
# From the Supabase dashboard: Settings -> API. The anon key is safe in the
# browser; row-level security is what protects the data. Never put the
# service-role key here -- it belongs only in backend/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- demo mode ---------------------------------------------------------------
# true  -> serve the seeded sample project, no backend calls, no LLM cost
# false -> talk to the real API
# Demo mode switches on automatically when the Supabase values above are blank.
VITE_DEMO_MODE=false

# --- marketing navigation ----------------------------------------------------
# Both patterns are built. 'top' is the slim glass navbar; 'vertical' is the
# same left rail the app uses. There is also an in-app switcher to compare them
# side by side without a rebuild.
VITE_MARKETING_NAV=top

# --- pipeline polling --------------------------------------------------------
# How often the pipeline view re-checks status while a stage is running, in ms.
VITE_PIPELINE_POLL_MS=2000
